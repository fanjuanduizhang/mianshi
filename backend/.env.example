# ============================================
# 配置说明
# ============================================
# 本项目不再使用 .env 文件，所有配置通过系统环境变量读取。
#
# Windows PowerShell 设置方法（临时，当前会话）：
#   $env:DEEPSEEK_API_KEY = "your_api_key"
#   $env:DASHSCOPE_API_KEY = "your_api_key"
#
# Windows PowerShell 设置方法（永久）：
#   [Environment]::SetEnvironmentVariable("DEEPSEEK_API_KEY", "your_api_key", "User")
#   [Environment]::SetEnvironmentVariable("DASHSCOPE_API_KEY", "your_api_key", "User")
#
# 设置后需要重启终端生效。
#
# ============================================
# 可选环境变量列表
# ============================================
# DEEPSEEK_API_KEY        - DeepSeek API Key
# DASHSCOPE_API_KEY       - 阿里云DashScope API Key
# DATABASE_URL            - 数据库路径（默认 sqlite:///./data/app.db）
# CHROMADB_PATH           - ChromaDB 存储路径
# UPLOAD_PATH             - 文件上传路径
# QUESTION_BANK_PATH      - 题库路径
# CORS_ORIGINS            - 允许跨域的地址
# ============================================

# 示例（请勿在此填写真实Key）：
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx